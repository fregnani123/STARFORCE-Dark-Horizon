{
  "name": "starforce-dark-horizon",
  "version": "1.0.0",
  "description": "Jogo de nave Starforce - Dark Horizon",
  "main": "main.js",
  "author": "Fabiano Fregnani",
  "license": "MIT",

  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },

  "devDependencies": {
    "electron": "^39.2.4",
    "electron-builder": "^24.13.3"
  },

  "build": {
    "appId": "com.starforce.darkhorizon",
    "productName": "Starforce - Dark Horizon",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
